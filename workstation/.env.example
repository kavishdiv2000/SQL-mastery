# Copy to .env (the setup scripts do this for you) and change if you like.
# These are local-only practice credentials - never reuse real passwords here.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PASSWORD=learnerpass

# Host ports (all bound to 127.0.0.1). Change if something else already uses them.
MYSQL_PORT=3306
ADMINER_PORT=8081
APP_PORT=3000
